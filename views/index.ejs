<!--
Homepage for Curate 

References: 
- Course lecture slides and hands on material
- stock images from pexels.com

-->
<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %> | Events Made Easy</title>

    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>

  <body>
    <!-- header and navigation -->
     <div id="navigation">
      <!--curate web app clickable logo-->
      <a href="/" class="logo-link">
        <img src="/images/main%20logo.png"
             alt="Curate Events Made Easy Logo"
             class="curate-logo">
      </a>

      <!-- navigation links-->
       <a href="/">Home</a>
       <a href="#categories">Event Categories</a>
       <a href="/events/create">Create Event</a>
       <a href="/events">View Events</a>
     </div>

     <!--hero section-->
    <div id="hero">
    <h2>Events Made Easy</h2>

    <p>
      Your next event starts here.
      Plan, Organize and Celebrate with Curate.
    </p>

    <a href="/events/create" class="hero-button">
      Create Your Event
    </a>
  </div>

  <!--event categories-->
  <div id="categories">

    <h2>Explore Event Categories</h2>

    <p>
      From small gatherings to grand celebrations,
      discover the possibilities with Curate.
    </p>

    <!--birthday-->
    <div class="category">
      <img src="/images/birthday.jpg" alt="Birthday event">
      <h3>Birthdays</h3>
    </div>

    <!--wedding-->
    <div class="category">
      <img src="/images/wedding.jpg" alt="Wedding event">
      <h3>Weddings</h3>
    </div>

    <!--corporate-->
    <div class="category">
      <img src="/images/corporate.jpg" alt="Corporate event">
      <h3>Corporate Events</h3>
    </div>

    <!--party-->
    <div class="category">
      <img src="/images/party.jpg" alt="Party event">
      <h3>Parties</h3>
    </div>

  </div>

    <!--footer-->
    <div id="footer">

      <p>Curate | Events Made Easy</p>

    </div>

  </body>
</html>
